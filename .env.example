# desde la UI (se guarda en la tabla app_settings) y este valor queda como fallback.
# Para poder editar inline usa la URL de EDICION del Sheet (.../spreadsheets/d/ID/edit),
# no la publicada (pubhtml, que es solo lectura).
LIBRETA_URL=
# Valor INICIAL del Flujo de fondos. Idem: se puede sobrescribir desde la UI.
FLUJO_FONDOS_URL=
