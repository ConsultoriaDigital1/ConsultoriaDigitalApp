NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://consultoria_user:cambiar_password@localhost:5432/consultoria_digital
DB_SSL=false
SESSION_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
COOKIE_SECURE=false
DEV_DB=true
DEV_SEED=true
GOOGLE_CALENDAR_CTZ=America/Argentina/Buenos_Aires
GOOGLE_CALENDAR_MARKETING_ID=
GOOGLE_CALENDAR_DESARROLLO_ID=
GOOGLE_CALENDAR_ADMIN_ID=
# ── Google Calendar EDITABLE (crear/editar/borrar eventos) ──
# Requiere una Service Account de Google. Ver GOOGLE_CALENDAR_SETUP.md.
# Opcion A (recomendada en local): ruta al archivo JSON de la service account.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Opcion B (recomendada en produccion/hosting): el JSON completo en una sola linea.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com",...}
# URL de la Libreta (pestania Libreta de Admin). Para cambiarla, edita este valor y
# reinicia el server. Pega el link de Google tal cual (la app lo normaliza); para poder
# editar inline usa la URL de EDICION del Sheet (.../spreadsheets/d/ID/edit),
# no la publicada (pubhtml, que es solo lectura).
LIBRETA_URL=
# URL del Flujo de fondos. Idem: edita el valor y reinicia el server.
FLUJO_FONDOS_URL=
