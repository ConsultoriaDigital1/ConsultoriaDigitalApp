{
  "name": "consultoria-digital",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch-path=server.js --watch-path=whatsapp-service.js --watch-path=google-calendar.js server.js",
    "setup:postgres": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-postgres.ps1",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:schema": "node db/schema.js",
    "db:seed": "node db/seed.js",
    "db:admin": "node db/create-admin.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  }
}
